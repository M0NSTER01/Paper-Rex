# ==========================================
# Khalsa - AI Portfolio Builder
# Environment Variables Example
# ==========================================

# ------------------------------------------
# FRONTEND (.env inside /frontend)
# ------------------------------------------
# URL of your deployed or local backend. Do NOT add a trailing slash (/).
VITE_BACKEND_URL=https://khalsa-lake.vercel.app

# Google OAuth Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com


# ------------------------------------------
# BACKEND (.env inside /backend)
# ------------------------------------------
# Port for local development
PORT=5000

# MySQL Database connection URI
# E.g., mysql://user:password@host:port/database_name
DB_URI=mysql://root:password@localhost:3306/portfolio_db

# JWT Secret for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Key (Required for Resume Extraction, Summary Enhancement, and Ask AI)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Google OAuth Client ID (Must match the frontend)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Netlify API Key and Site ID for direct deployment from the Editor
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token_here
NETLIFY_SITE_ID=your_netlify_site_id_here
